// #######################################################################################
// NIRI CONFIGURATION (Surgical NixOS Optimized)
// #######################################################################################

// --- AUTOSTART ---
// Session-local UI processes only. (No KDE backend daemons on this host.)

hotkey-overlay {
    skip-at-startup
}

// UI layer — session-local UI processes
spawn-at-startup "noctalia"
spawn-at-startup "stretchly"
// swww-daemon retired in favour of awww (qlex backend) — never run both,
// they fight over the same outputs.
spawn-at-startup "awww-daemon"
spawn-at-startup "qlexd"


// xwayland-satellite is intentionally NOT spawned here.
// Niri spawns it on demand for X11 clients (DISPLAY below enables this),
// provided the package is installed (see modules/packages.nix).

// --- ENVIRONMENT VARIABLES ---
environment {
    QT_QPA_PLATFORM     "wayland"
    NIXOS_OZONE_WL      "1"
    DISPLAY             ":0" // XWayland-Satellite bridge for legacy apps

    // XDG_CURRENT_DESKTOP is also set in environment.sessionVariables
    // in modules/desktop.nix. Kept here as well so niri's own environment
    // is consistent for any app that reads it from the compositor directly.
    XDG_CURRENT_DESKTOP "niri"
}

cursor {
    xcursor-size 24
}

// --- INPUT ---
input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
        dwt // "Disable While Typing" - helps prevent accidental cursor jumps
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.5
    }
}

// --- LAYOUT & DESIGN ---
layout {
    gaps 10
    center-focused-column "never"

    focus-ring {
        on
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    border {
        off
    }

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// --- WINDOW RULES ---
// (Rules for uninstalled apps — swaync, librewolf, zed, code, Alacritty,
// electron — were pruned. Re-add when you install the app.)

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="kitty"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match is-active=false
    opacity 0.85
}

window-rule {
    match app-id="org.gnome.Nautilus"
    default-column-width { proportion 0.5; }
    draw-border-with-background false
}

window-rule {
    match app-id="brave-browser"
    open-maximized true
}

// --- KEYBINDINGS ---
binds {
    // App Launches
    Mod+Q { spawn "ghostty"; }
    Mod+I { spawn "kitty"; }
    Mod+E { spawn "nautilus"; }
    Mod+A hotkey-overlay-title="Open App Launcher: noctalia launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }
    Mod+Shift+P hotkey-overlay-title="Open Session Management: noctalia session" {
        spawn-sh "noctalia msg panel-toggle session"
    }
    Mod+S hotkey-overlay-title="Open emoji picker : noctalia-emoji" {
      spawn-sh "noctalia msg panel-toggle launcher /e/ " 
    }
    Mod+D hotkey-overlay-title="Open notification center" {
spawn-sh "noctalia msg panel-toggle control-center notifications"

    }

    Mod+M hotkey-overlay-title="Open clipboard : noctalia clipboard" {
      spawn-sh "noctalia msg panel-toggle clipboard"
    }

    Mod+B { spawn "brave"; }
    Mod+N { spawn "ghostwriter"; }
    Mod+W hotkey-overlay-title="Wallpaper picker : qlex" { spawn "qlex" "ui"; }

    // Window Management
    Mod+C { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Session Management
    Mod+Return { spawn "qlock"; }
    Mod+Shift+E { quit; }

    // Screenshots
    Super+Print { screenshot; }
    Print { screenshot-screen; }

    // Navigation & Overview
    Mod+Shift+B { show-hotkey-overlay; }
    Mod+O { toggle-overview; }

    // Tiling Navigation (Vim-style)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    // Tiling Movement
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }

    // Workspace Switching
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Column Resizing
    Mod+Y { set-column-width "-10%"; }
    Mod+U { set-column-width "+10%"; }
    Mod+R { switch-preset-column-width; }
    Mod+Space { center-column; }

    // Column Mechanics
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Media Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

// noctalia.kdl is generated at runtime by Noctalia's theme engine
// (theme.templates includes "niri") — keep it writable, never store-manage it.
include "noctalia.kdl"
