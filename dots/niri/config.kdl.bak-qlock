// #######################################################################################
// NIRI CONFIGURATION (Surgical NixOS Optimized)
// #######################################################################################

// --- AUTOSTART ---
// Rule of thumb for what goes here vs systemd:
//   spawn-at-startup → UI components (bars, wallpaper, idle daemon, apps)
//   systemd user service → background daemons (KDE services, xwayland-satellite)
//
// All KDE backend daemons (kded6, kglobalacceld, polkit-kde-agent, knighttime,
// kactivitymanagerd, baloo, kscreen-backend) are managed by systemd in wm.nix.
// xwayland-satellite is also a systemd service — see note below.

hotkey-overlay {
    skip-at-startup
}

// UI layer — session-local UI processes
// spawn-at-startup "dms" "run"
spawn-at-startup "noctalia"
// spawn-at-startup "hypridle"
spawn-at-startup "stretchly"
spawn-at-startup "skwd-walld"
// spawn-at-startup "swww-daemon"


// xwayland-satellite is intentionally NOT spawned here.
// It runs as a systemd user service (xwayland-satellite.service in wm.nix)
// so it is ready before any XWayland app requests it, not after niri loads.

// --- ENVIRONMENT VARIABLES ---
environment {
    QT_QPA_PLATFORM     "wayland"
    NIXOS_OZONE_WL      "1"
    DISPLAY             ":0" // XWayland-Satellite bridge for legacy apps

    // XDG_CURRENT_DESKTOP is already set in environment.sessionVariables
    // in wm.nix. Kept here as well so niri's own environment is consistent
    // for any app that reads it from the compositor directly.
    XDG_CURRENT_DESKTOP "niri"
}

cursor {
    xcursor-size 24
}

// --- INPUT ---
input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
        dwt // "Disable While Typing" - helps prevent accidental cursor jumps
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.5
    }
}

// --- LAYOUT & DESIGN ---
layout {
    gaps 10
    center-focused-column "never"

    focus-ring {
        on
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    border {
        off
    }

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// --- PRIVACY & RENDERING ---
layer-rule {
    match namespace="swaync-notification-window"
    match namespace="swaync-control-center"
    block-out-from "screen-capture"
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="librewolf"
    open-maximized true
}

window-rule {
    match app-id="dev.zed.Zed"
    open-maximized true
}

window-rule {
    match app-id="code"
    open-maximized true
}

window-rule {
    match app-id="Alacritty"
    opacity 0.5
}

window-rule {
    match app-id="kitty"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match is-active=false
    opacity 0.85
}

window-rule {
    match app-id="nemo"
    default-column-width { proportion 0.5; }
    draw-border-with-background false
}

window-rule {
    match app-id="brave-browser"
    open-maximized true
}

window-rule {
    match app-id="electron"
    open-maximized true
}

// --- KEYBINDINGS ---
binds {
    // App Launches
    Mod+Q { spawn "ghostty"; }
    Mod+I { spawn "kitty"; }
    Mod+E { spawn "nemo"; }
    Mod+A hotkey-overlay-title="Open App Launcher: noctalia launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }
    Mod+Shift+P hotkey-overlay-title="Open Session Management: noctalia session" {
        spawn-sh "noctalia msg panel-toggle session"
    }
    Mod+S hotkey-overlay-title="Open emoji picker : noctalia-emoji" {
      spawn-sh "noctalia msg panel-toggle launcher /e/ " 
    }
    Mod+D hotkey-overlay-title="Open notification center" {
spawn-sh "noctalia msg panel-toggle control-center notifications"

    }

    Mod+M hotkey-overlay-title="Open clipboard : noctalia clipboard" {
      spawn-sh "noctalia msg panel-toggle clipboard"
    }

    Mod+B { spawn "brave"; }
    Mod+N { spawn "ghostwriter"; }
    Mod+W { spawn "parallex" "run"; }
    Mod+T hotkey-overlay-title="Skwd-wall" { spawn "skwd-wall-v2"; }

    // Window Management
    Mod+C { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Theme Toggle
    Mod+Shift+D { spawn "toggle-mode"; }

    // Session Management
    // NOTE: Mod+Shift+P (= Super+Shift+P) is also bound in dms/binds.kdl
    // to the DMS power menu — pressing it currently triggers both.
    Mod+Return { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+E { quit; }

    // Screenshots
    Super+Print { screenshot; }
    Print { screenshot-screen; }

    // Navigation & Overview
    Mod+Shift+B { show-hotkey-overlay; }
    Mod+O { toggle-overview; }

    // Tiling Navigation (Vim-style)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    // Tiling Movement
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }

    // Workspace Switching
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Column Resizing
    Mod+Y { set-column-width "-10%"; }
    Mod+U { set-column-width "+10%"; }
    Mod+R { switch-preset-column-width; }
    Mod+Space { center-column; }

    // Column Mechanics
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Media Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

include "dms/cursor.kdl"
include "dms/binds.kdl"
include "dms/windowrules.kdl"

include "noctalia.kdl"
